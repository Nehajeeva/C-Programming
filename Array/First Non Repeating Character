#include <stdio.h>
#include <ctype.h>
int main(){
    int i,j,c;
    char s[100];
    fgets(s,sizeof(s),stdin);
    for(i=0;s[i]!='\0';i++){
        c=0;
        for(j=0;s[j]!='\0';j++){
            if(s[i]==s[j]){
                c++;
            }
        }
        if(c==1){
            printf("%c",s[i]);
            break;
        }
    }
    return 0;
}
